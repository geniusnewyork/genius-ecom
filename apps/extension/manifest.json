{
  "manifest_version": 3,
  "name": "MONTY GENIUS SELLER ASSISTANT",
  "version": "1.0.0",
  "description": "Free Form Autofill, Product Catalog Manager & Listing Assistant for Smart Online Sellers",
  "author": "Mr. Monty Genius",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "MONTY GENIUS SELLER ASSISTANT",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*/*"
  ]
}
