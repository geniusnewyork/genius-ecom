{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@monty-genius/shared-types": ["../../packages/shared-types/src"],
      "@monty-genius/config": ["../../packages/config/src"],
      "@monty-genius/calculator-engine": ["../../packages/calculator-engine/src"],
      "@monty-genius/validation": ["../../packages/validation/src"],
      "@monty-genius/ui": ["../../packages/ui/src"]
    },

    /* Relaxed for rapid development */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src"]
}
