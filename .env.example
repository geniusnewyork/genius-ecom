# ==========================================
# MONTY GENIUS ECOM TOOLS — Environment Configuration
# ==========================================

# Application Mode: 'development' or 'production'
# In development mode, owner enjoys full access without license requirement
APP_ENV=development
LICENSE_REQUIRED=false

# Port configurations
PORT=3001
WEB_PORT=5173
ADMIN_PORT=5174

# Database Configuration (Defaults to local file-backed SQLite database in data/license_db.json)
DATABASE_URL=sqlite://data/license_db.json

# License Engine Cryptographic Secrets (Generate 32-character random hex strings in production)
JWT_SECRET=replace_with_secure_random_jwt_secret_in_prod_2026
LICENSE_SIGNING_SECRET=replace_with_secure_random_hmac_signing_secret_in_prod_2026
ADMIN_SESSION_SECRET=replace_with_secure_random_admin_session_secret_in_prod_2026

# Default Initial Administrator Credentials (Change on first login in production)
ADMIN_EMAIL=admin@montygenius.com
ADMIN_PASSWORD=Admin@MontyGenius2026!

# Payment Gateway Configuration (Pluggable provider: 'mock', 'razorpay', 'stripe')
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Public URLs
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
PUBLIC_ADMIN_URL=http://localhost:5174
